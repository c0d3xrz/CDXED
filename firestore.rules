rules_version = '2';

// CDXED — Firestore Security Rules
//
// Public visitors (and the site itself) can READ everything, so the
// portfolio works for anyone without logging in.
// Only a signed-in user (i.e. someone who passed the /admCDX login,
// which is validated by Firebase Authentication) can WRITE.
//
// This replaces the default "allow read, write: if true" rule, which
// currently lets ANYONE on the internet edit or delete your data directly
// through the Firebase SDK, bypassing the admin panel entirely.
//
// How to apply: Firebase Console → Firestore Database → Rules → paste this
// entire file → Publish. (Or deploy with the Firebase CLI: `firebase deploy
// --only firestore:rules` using the included firebase.json.)

service cloud.firestore {
  match /databases/{database}/documents {

    // config/profile — Michel's profile info (name, bio, skills, etc.)
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // certificates/{id} — courses & certifications shown on the timeline
    match /certificates/{certId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // projects/{id} — portfolio video projects
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Anything else: deny by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
